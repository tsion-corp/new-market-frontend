{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "new-market",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "observability": {
    "enabled": true,
  },
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "new-market" }],
  "env": {
    "staging": {
      "name": "new-market-staging",
      "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "new-market-staging" }],
    },
  },
}
